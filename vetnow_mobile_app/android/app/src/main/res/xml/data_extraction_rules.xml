<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above. Same intent as backup_rules.xml, in the newer
  format: settings travel, credentials do not.

  device-transfer is the phone-to-phone copy during setup; cloud-backup
  is Google Drive. The session token is excluded from both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
