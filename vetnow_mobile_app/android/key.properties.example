# Copy to android/key.properties and fill in. That file is gitignored:
# it names a keystore and carries its passwords, and neither belongs in
# the repository.
#
# Create the upload key once (keep the .jks and these passwords safe —
# lose them and the app can never be updated under the same listing):
#
#   keytool -genkey -v -keystore vetnow-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias vetnow
#
# storeFile is resolved relative to the android/ directory.

storeFile=vetnow-upload.jks
storePassword=
keyAlias=vetnow
keyPassword=
